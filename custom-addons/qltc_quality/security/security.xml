<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="group_qa_engineer" model="res.groups">
        <field name="name">QA Engineer</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_quality_manager" model="res.groups">
        <field name="name">Quality Manager</field>
        <field name="implied_ids" eval="[(4, ref('qltc_quality.group_qa_engineer'))]"/>
    </record>

    <!-- QA Engineer can access only own records -->
    <record id="rule_nc_engineer_own" model="ir.rule">
        <field name="name">QA Engineer: Own NCs Only</field>
        <field name="model_id" ref="model_quality_nc"/>
        <field name="groups" eval="[(4, ref('qltc_quality.group_qa_engineer'))]"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
    </record>

    <!-- Quality Manager can access all records -->
    <record id="rule_nc_manager_all" model="ir.rule">
        <field name="name">Quality Manager: All NCs</field>
        <field name="model_id" ref="model_quality_nc"/>
        <field name="groups" eval="[(4, ref('qltc_quality.group_quality_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
